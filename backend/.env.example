# SQLite local database filepath configuration
# Use sqlite:///database.db for standard SQLite in root
DATABASE_URL=sqlite:///./database.db

# Google OAuth 2.0 Web Application Credentials (Client ID only, not the secret)
# Find your Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# JWT Secret - generate a strong random key for production
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: -join (([char[]]([char]33..[char]126)) | Get-Random -Count 32)
JWT_SECRET=da717b8580ed7817d3aa6c8b694389cde577b3559a178639518c9ad4755275f8 # rotated v3.1 — use `openssl rand -hex 32` for your own

# Daily limit removed — unlimited scans (set high to disable). Override to e.g. 10 to re-enable.
FREE_DAILY_MEDIA_SCANS=999999

# Redis URL for persistent rate limiting (falls back to in-memory if not set)
# Example: redis://localhost:6379/0  or  rediss://:password@host:6380/0
REDIS_URL=redis://localhost:6379/0

# Feature flags
ENABLE_CLIP=0
# VirusTotal API key (optional, for URL threat intel)
VIRUSTOTAL_API_KEY=

# Comma-separated admin emails; admins can hide/unhide/delete community reports.
ADMIN_EMAILS=you@example.com