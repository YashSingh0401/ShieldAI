# SQLite local database filepath configuration
# Use sqlite:///database.db for standard SQLite in root
DATABASE_URL=sqlite:///./database.db

# Google OAuth 2.0 Web Application Credentials (Client ID only, not the secret)
# Find your Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# JWT Secret - generate a strong random key for production
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: -join (([char[]]([char]33..[char]126)) | Get-Random -Count 32)
JWT_SECRET=change-this-to-a-random-secret-key