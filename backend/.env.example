# SQLite local database filepath configuration
# Use sqlite:///database.db for standard SQLite in root
DATABASE_URL=sqlite:///database.db

# Google OAuth 2.0 Web Application Credentials
# Paste your real Google Client ID and Secret from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
